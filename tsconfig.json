/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true, //use override keyword everywhere
    "noPropertyAccessFromIndexSignature": true, //obj['key'] notation not obj.key
    "noImplicitReturns": true, //return value from every path of function
    "noFallthroughCasesInSwitch": true, //writing break/return is mandatory
    "skipLibCheck": true, //skips type checking of .d.ts files
    "isolatedModules": true,
    "experimentalDecorators": true, //can use decorators like @components,@injectable
    "importHelpers": true, //import tslib helpers not paste the whole helper function
    "target": "ES2022", //ECMAScript 2022
    "module": "preserve", //automatic resolution
    "paths": {
      "@src/*": ["./src/*"],
      "@modules/*": ["./src/app/modules/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@core/*": ["./src/app/core/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false, //convert website to diff languages; rejects legacy methods and allows new ones
    "strictInjectionParameters": true, // correct types are given to service injections not any
    "strictInputAccessModifiers": true //not readonly or private in @Input properties
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
